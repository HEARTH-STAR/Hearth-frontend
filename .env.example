# Hearth-frontend: environment variables
#
# HEARTH is three repos that run side by side (github.com/HEARTH-STAR):
#
#   Hearth-frontend  this web app             http://127.0.0.1:4310 (dev UI on :5173)
#   Hearth-backend   container spin-up        http://127.0.0.1:5020  → HEARTH_BACKEND_URL
#   Hearth-Core      Claude Code + workspace  :5010 inside each Space's container
#
# Each Space is a container from Hearth-backend's `space` template, running Hearth-Core;
# Claude Code and GitHub are signed in inside it from the Space's page. Only this server
# talks to Hearth-backend and the Spaces' Hearth-Core; the browser never does.
#
# Precedence, lowest to highest: defaults in code → .env → exported shell vars.

# ──────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4310
# Spaces, pages, Dots, conversations and computer records.
DATABASE_PATH=data/hearth.sqlite
# Conversation history (AG-UI run events). Default: hearth-threads.sqlite next to DATABASE_PATH.
# THREADS_DATABASE_PATH=data/hearth-threads.sqlite
# Keep OWNER_ID stable: it owns the conversations in the database.
OWNER_ID=hearth-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Hearth services
# ──────────────────────────────────────────────────────────────────────────
# Hearth-backend (github.com/HEARTH-STAR/Hearth-backend) spins up each Space's container
# (needs Docker). Start it with ./hearth-backend.sh serve in that repo.
HEARTH_BACKEND_URL=http://127.0.0.1:5020
# Must equal Hearth-backend's HEARTH_API_TOKEN when that is set; leave unset otherwise.
# HEARTH_BACKEND_TOKEN=
# Hearth-backend template for Space containers. It must run Hearth-Core on port 5010 and
# publish it; `space` clones github.com/HEARTH-STAR/Hearth-Core@main and does.
# HEARTH_CONTAINER_TEMPLATE=space
# Where this server reaches the ports Space containers publish (Docker binds them to
# 127.0.0.1). Change it only when this server runs somewhere else than Docker.
# HEARTH_SPACE_HOST=127.0.0.1
# Model for conversations; Hearth-Core's HEARTH_MODEL / manifest default when unset.
# HEARTH_MODEL=claude-opus-5-5

# ──────────────────────────────────────────────────────────────────────────
# CopilotKit
# ──────────────────────────────────────────────────────────────────────────
# The CopilotKit runtime runs locally (no Intelligence). Opt out of its SDK usage telemetry:
COPILOTKIT_TELEMETRY_DISABLED=true
# CopilotKit's Inspector (AG-UI events, agent messages) in npm run dev; off unless true.
# VITE_COPILOTKIT_INSPECTOR=true
